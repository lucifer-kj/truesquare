# TrueSquare Environment Configuration Template
# Copy this file to .env or set these in your Vercel Project Settings

# 1. Neon Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth Random Encryption Secret (Generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="your-32-character-random-secret-key-goes-here"

# 3. Application Base URL (Local development or production domain)
BETTER_AUTH_URL="http://localhost:5173"

# 4. Email Webhook Dispatch Configuration (n8n or custom webhook)
EMAIL_WEBHOOK_URL="https://n8n.your-domain.com/webhook/your-webhook-id"
EMAIL_WEBHOOK_AUTH_TOKEN="your-webhook-bearer-token"
